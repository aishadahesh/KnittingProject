{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Knitting App",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "purpose": ["debug-in-terminal"]
    },
    {
      "name": "Run Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "purpose": ["debug-in-terminal"]
    }
  ]
}
