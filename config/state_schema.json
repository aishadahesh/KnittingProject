{
  "app_config": {
    "workflow_stages": [
      {
        "title": "Align",
        "subtitle": "Match the model and reference image in the viewport."
      },
      {
        "title": "Pattern",
        "subtitle": "Set bitmap size, row visibility, and stitch pattern."
      },
      {
        "title": "Geometry",
        "subtitle": "Tune yarn radius and knitting path parameters."
      },
      {
        "title": "Surface Fibers",
        "subtitle": "Add separate fiber meshes above the yarn surface."
      },
      {
        "title": "Material",
        "subtitle": "Choose opacity and yarn colors."
      },
      {
        "title": "Texture",
        "subtitle": "Tune the yarn texture tint and see it live."
      },
      {
        "title": "Display",
        "subtitle": "Set viewport copies and repeated model preview."
      },
      {
        "title": "Lighting",
        "subtitle": "Adjust scene lighting and see it live."
      },
      {
        "title": "Spline",
        "subtitle": "Refine control points when the coarse shape is close."
      },
      {
        "title": "Scanner",
        "subtitle": "Build the scan fabric and launch the UR5 scanner visualization."
      },
      {
        "title": "Review",
        "subtitle": "Save and load the current model."
      }
    ],
